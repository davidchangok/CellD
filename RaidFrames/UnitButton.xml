<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Button name="CellUnitButtonTemplate" inherits="BackdropTemplate,SecureUnitButtonTemplate,SecureHandlerEnterLeaveTemplate,SecureHandlerShowHideTemplate" hidden="true" virtual="true">
        <Attributes>
            <Attribute name="toggleForVehicle" type="boolean" value="true"/>
            <Attribute name="checkselfcast" type="boolean" value="false"/>
            <Attribute name="checkfocuscast" type="boolean" value="false"/>
            <!-- <Attribute name="allowVehicleTarget" type="boolean" value="true"/> -->
            <!-- <Attribute name="ping-receiver" type="boolean" value="true"/> -->
        </Attributes>
        <Scripts>
            <OnLoad>
                CellUnitButton_OnLoad(self)
            </OnLoad>
        </Scripts>
    </Button>

    <Button name="CellPreviewButtonTemplate" inherits="BackdropTemplate" hidden="true" virtual="true">
        <Scripts>
            <OnLoad>
                CellUnitButton_OnLoad(self)
                self.isPreview = true
            </OnLoad>
        </Scripts>
    </Button>

    <!-- 12.1 AuraContainer 统一光环显示 (v1.3.0)
         官方光环容器: 引擎内建追踪/过滤/倒计时, 战斗中亦能显示被 secret 化的
         治疗 HoT/buff(实测 2026-08-18 推翻旧"AuraContainer 受限"结论)。
         替代 SecretAuraTracker 施放追踪, 脱战/战斗统一引擎渲染。 -->
    <ScopedModifier useForbiddenObjectTable="true">
        <AuraContainer name="CellDAuraContainerTemplate" inherits="CustomAuraContainerTemplate" virtual="true" />

        <AuraButton name="CellDAuraButtonTemplate" inherits="CustomAuraButtonTemplate" virtual="true">
            <Layers>
                <Layer level="BORDER">
                    <Texture parentKey="IconTexture" setAllPoints="true" />
                </Layer>
                <Layer level="OVERLAY">
                    <FontString parentKey="TimerText" />
                    <FontString parentKey="CountText" />
                </Layer>
            </Layers>
            <Frames>
                <Cooldown parentKey="DurationCooldown" inherits="CooldownFrameTemplate" setAllPoints="true" reverse="true" hideCountdownNumbers="true" drawSwipe="true" drawEdge="true" drawBling="false" />
            </Frames>
        </AuraButton>
    </ScopedModifier>
</Ui>